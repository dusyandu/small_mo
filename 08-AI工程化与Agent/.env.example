# ============================================
# OJ AC 助手 Agent 环境变量配置模板
# ============================================
# 复制本文件为 .env 并填入你的真实凭证
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env (Windows)

# ---- 智谱 GLM API（必填，Agent 核心）----
# 获取地址：https://open.bigmodel.cn/  → 控制台 → API Keys
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# ---- 超级鹰验证码识别（可选，仅当 OJ 网站出现验证码时需要）----
# 获取地址：http://www.chaojiying.com/
CHAOJIYING_USER=your_chaojiying_username
CHAOJIYING_PWD=your_chaojiying_password
CHAOJIYING_SOFTID=your_chaojiying_softid
